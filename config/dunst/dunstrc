# Archther Dark — Dunst notification theme
#
# Palette reference: config/hypr/themes/archther.lua (canonical tokens) and
# context/ui-tokens.md. Urgency colors reuse canonical Archther values; text
# tones are documented supporting colors, not brand tokens.
# Key set matches Dunst 1.13 (installed 1.13.2; reference /etc/dunst/dunstrc).
# Standalone file: when present at ~/.config/dunst/dunstrc it replaces the
# system default, so all needed keys are set explicitly here.

[global]
    ### Display ###
    monitor = 0
    follow = none

    ### Geometry ###
    width = 300
    height = (0, 300)
    origin = top-right
    offset = (10, 50)
    scale = 0
    notification_limit = 20

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0
    progress_bar_corners = all
    icon_corner_radius = 0
    icon_corners = all

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#0B2A6F"
    gap_size = 0
    separator_color = frame
    sort = yes

    ### Text (Adwaita Sans verified present via fc-list) ###
    font = Adwaita Sans 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    enable_posix_regex = false

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 32
    max_icon_size = 128
    icon_path = /usr/share/icons/gnome/16x16/status/:/usr/share/icons/gnome/16x16/devices/

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc/Advanced ###
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 8
    corners = all
    ignore_dbusclose = false

    ### Wayland ###
    force_xwayland = false

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    # IMPORTANT: colors have to be defined in quotation marks.
    background = "#111827"
    foreground = "#94A3B8"
    timeout = 10

[urgency_normal]
    background = "#0B0F14"
    foreground = "#F8FAFC"
    timeout = 10
    override_pause_level = 30

[urgency_critical]
    background = "#0B0F14"
    foreground = "#F8FAFC"
    frame_color = "#E8A11C"
    timeout = 0
    override_pause_level = 60
